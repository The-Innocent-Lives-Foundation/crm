# ─────────────────────────────────────────────
# Resend Bridge Configuration
# ─────────────────────────────────────────────

# HTTP port the bridge listens on
PORT=3100

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Default sender identity (must use a verified Resend domain)
RESEND_FROM_EMAIL=notifications@go.innocentlivesfoundation.org
RESEND_FROM_NAME=Innocent Lives Foundation

# API key that Twenty workflows must send to authenticate /api/send calls
# Generate a random string: openssl rand -hex 32
BRIDGE_API_KEY=change-me-to-a-long-random-string

# Public base URL where this bridge is reachable (used for unsubscribe links)
# Uses the existing nginx reverse proxy + Cloudflare edge SSL — no tunnel needed
PUBLIC_BASE_URL=https://crm.innocentlivesfoundation.org/email

# ─── Twenty CRM integration (optional but recommended) ───
# Twenty GraphQL endpoint (inside Docker network use http://server:3000/graphql)
TWENTY_API_URL=http://server:3000/graphql

# Twenty API access token (Settings → API Keys in Twenty UI)
TWENTY_API_KEY=

# Custom object singular name used to store suppression / unsubscribe records
# Create this object in Twenty: Settings → Objects → "emailSuppression"
TWENTY_SUPPRESSION_OBJECT=emailSuppression

# ─── Resend webhook verification (optional) ───
# Resend webhook signing secret (from Resend dashboard → Webhooks)
# If set, incoming webhook payloads are verified with svix
RESEND_WEBHOOK_SECRET=

# ─── Rate limiting ───
# Max emails per minute the bridge will send (0 = unlimited)
RATE_LIMIT_PER_MINUTE=120
